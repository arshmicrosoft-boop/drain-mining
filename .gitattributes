# Normalise line endings so a clone on any platform diffs cleanly.
# The repo is TypeScript only; anything else is data.
* text=auto eol=lf

*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary

# Keep the generated lockfile out of merge conflicts.
package-lock.json merge=binary linguist-generated
